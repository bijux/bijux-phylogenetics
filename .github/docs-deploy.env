# The manual publisher selects the same artifact for build and independent verification.
BIJUX_DOCS_INSTALL_COMMAND='make root-check-env'
BIJUX_DOCS_BUILD_COMMAND='make docs-check DOCS_CHECK_SITE_DIR=artifacts/docs/site'
BIJUX_DOCS_VERIFY_COMMAND='DOCS_PYTHON=artifacts/root/check-venv/bin/python bash .bijux/shared/bijux-docs/tooling/scripts/verify_bijux_docs_site.sh'
BIJUX_DOCS_SITE_DIR='artifacts/docs/site'
BIJUX_DOCS_SETUP_UV='true'
BIJUX_DOCS_SETUP_PYTHON='true'
BIJUX_DOCS_PYTHON_VERSION='3.11'
BIJUX_DOCS_SETUP_NODE='true'
BIJUX_DOCS_NODE_VERSION='24.21.0'
